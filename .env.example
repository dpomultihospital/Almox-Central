# Porta HTTP do servidor (altere para 3010, 4000, etc., caso a 3000 esteja em uso por outra aplicação)
PORT=3000

# Ambiente de execução (development | production)
NODE_ENV=production

# Caminho do arquivo de banco de dados SQLite (opcional - padrão: ./almoxarifado.db)
SQLITE_DB_PATH=./almoxarifado.db

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

